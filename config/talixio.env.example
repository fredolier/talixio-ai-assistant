# Talixio configuration. After editing: sudo systemctl restart talixio-worker talixio-web
# Check with: sudo talixio doctor

# ---- Brain -----------------------------------------------------------------
# anthropic   : Claude API (needs ANTHROPIC_API_KEY)
# openai      : OpenAI API, or any OpenAI-compatible server via OPENAI_BASE_URL (Ollama, vLLM, OpenRouter)
# claude-code : the Claude Code CLI with your Claude Pro/Max subscription (run ./install.sh --with-claude-code)
# echo        : no model, for checking the install
TALIXIO_PROVIDER=echo
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# Long-lived token from `claude setup-token` (claude-code provider only)
CLAUDE_CODE_OAUTH_TOKEN=
TALIXIO_CLAUDE_BIN=/var/lib/talixio/.local/bin/claude

# ---- Model tiers -----------------------------------------------------------
# fast: heartbeat, summaries, simple sub-agent lookups. standard: chat. deep: hard reasoning (start a message with /deep).
# Empty = provider defaults (Claude: haiku / sonnet / opus; claude-code: haiku / sonnet / opus aliases).
TALIXIO_MODEL_FAST=
TALIXIO_MODEL=
TALIXIO_MODEL_DEEP=
# Claude extended thinking for the deep tier (tokens, 0 = off)
TALIXIO_DEEP_THINKING_TOKENS=8000
# OpenAI reasoning models only: low | medium | high (leave empty for non-reasoning models)
TALIXIO_DEEP_REASONING_EFFORT=

# ---- Budget (USD, estimated from list prices; 0 = no limit) -----------------
# Over 80%: switches to the fast tier and stops starting sub-agents. At 100%: stops calling models.
# With the claude-code provider the cost is the API-equivalent reported by Claude Code (your plan covers it).
TALIXIO_BUDGET_DAILY_USD=3
TALIXIO_BUDGET_MONTHLY_USD=30
# Override prices per million tokens: pattern=input/output, e.g. sonnet=3/15,opus=5/25
TALIXIO_PRICES=

# ---- Sub-agents (background jobs) ------------------------------------------
TALIXIO_MAX_PARALLEL_JOBS=3
TALIXIO_JOB_MAX_USD=0.50

# ---- Memory search ---------------------------------------------------------
# Keyword search (SQLite FTS5) is always on. Embeddings add meaning-based search:
# auto (Voyage if VOYAGE_API_KEY, else OpenAI if OPENAI_API_KEY) | ollama | openai | voyage | off
TALIXIO_EMBEDDINGS=auto
TALIXIO_EMBEDDINGS_MODEL=
TALIXIO_OLLAMA_URL=http://127.0.0.1:11434
VOYAGE_API_KEY=
TALIXIO_HISTORY_MESSAGES=40

# ---- You -------------------------------------------------------------------
TALIXIO_NAME=Talixio
TALIXIO_TIMEZONE=Europe/Paris

# ---- Web app ---------------------------------------------------------------
TALIXIO_WEB_PASSWORD=
# 127.0.0.1:8080 = local only (SSH tunnel, or Caddy on this VM via install.sh --domain).
# Reverse proxy on another machine: the VM's private IP, e.g. 10.0.0.5:8080 (install.sh --bind), firewalled to the proxy.
TALIXIO_WEB_BIND=127.0.0.1:8080

# ---- Notifications ---------------------------------------------------------
# Channels that receive messages the assistant starts (reminders, briefings, job results).
# Only configured ones are used. Push from the web app is turned on per device on the Channels page.
TALIXIO_NOTIFY=webpush,email,signal,telegram,ntfy
# Contact for push services (VAPID). Defaults to mailto:<TALIXIO_EMAIL_TO>.
TALIXIO_VAPID_SUBJECT=

# ---- Email -----------------------------------------------------------------
# Outgoing (SMTP). Port 587 = STARTTLS, 465 = TLS. Gmail: smtp.gmail.com + an app password.
TALIXIO_SMTP_HOST=
TALIXIO_SMTP_PORT=587
TALIXIO_SMTP_SECURITY=auto
TALIXIO_SMTP_USER=
TALIXIO_SMTP_PASSWORD=
# The assistant's address, e.g. Talixio <assistant@example.com>. Defaults to TALIXIO_SMTP_USER.
TALIXIO_EMAIL_FROM=
# Your address: notifications go here.
TALIXIO_EMAIL_TO=
# Incoming (IMAP, port 993): the assistant answers emails sent to its mailbox. Use a dedicated mailbox.
# User/password default to the SMTP ones.
TALIXIO_IMAP_HOST=
TALIXIO_IMAP_PORT=993
TALIXIO_IMAP_USER=
TALIXIO_IMAP_PASSWORD=
TALIXIO_IMAP_FOLDER=INBOX
# Senders it answers (comma-separated). Defaults to TALIXIO_EMAIL_TO.
TALIXIO_EMAIL_ALLOWED=
# 1 = only answer mail your mail server verified (SPF/DKIM/DMARC pass), so forged senders are ignored.
TALIXIO_EMAIL_REQUIRE_AUTH=1

# ---- Signal ----------------------------------------------------------------
# A number dedicated to the assistant (install with ./install.sh --with-signal, register: see README).
TALIXIO_SIGNAL_NUMBER=
# Your number(s), international format, comma-separated: the only ones it answers and notifies.
TALIXIO_SIGNAL_ALLOWED=
TALIXIO_SIGNAL_CLI=signal-cli

# ---- ntfy (alternative push app) -------------------------------------------
# Use a long random topic name: anyone who knows it can read your notifications.
TALIXIO_NTFY_URL=
TALIXIO_NTFY_TOKEN=

# ---- Telegram (optional) ---------------------------------------------------
# Token from @BotFather. Message the bot once; it replies with your chat id to put below.
TALIXIO_TELEGRAM_TOKEN=
TALIXIO_TELEGRAM_ALLOWED_IDS=

# ---- Web search ------------------------------------------------------------
# auto: Brave/Tavily/SearXNG if a key or URL is set below, else the model's built-in search (Claude)
TALIXIO_SEARCH=auto
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=

# ---- Proactivity -----------------------------------------------------------
# Minutes between heartbeat checks of HEARTBEAT.md (fast tier). 0 = off.
TALIXIO_HEARTBEAT_MINUTES=0

TALIXIO_DATA_DIR=/var/lib/talixio
