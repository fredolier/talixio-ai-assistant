#!/bin/sh
set -e
if [ "$1" = configure ]; then
    getent group talixio >/dev/null || addgroup --system talixio
    getent passwd talixio >/dev/null || adduser --system --ingroup talixio --home /var/lib/talixio --no-create-home --shell /usr/sbin/nologin talixio
    install -d -o talixio -g talixio -m 750 /var/lib/talixio
    chown root:talixio /etc/talixio/talixio.env && chmod 640 /etc/talixio/talixio.env
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl enable talixio.service >/dev/null || true
        # Only (re)start if configured; first install needs the token in talixio.env.
        if grep -Eq '^TALIXIO_TELEGRAM_TOKEN=.+' /etc/talixio/talixio.env; then
            systemctl restart talixio.service || true
        else
            echo "talixio: edit /etc/talixio/talixio.env then run: sudo systemctl restart talixio"
        fi
    fi
fi
