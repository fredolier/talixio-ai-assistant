# Talixio configuration. After editing: sudo systemctl restart talixio
TALIXIO_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# TALIXIO_MODEL=
TALIXIO_DB_PATH=/var/lib/talixio/talixio.db
TALIXIO_NAME=Talixio
TALIXIO_TELEGRAM_TOKEN=
# Comma-separated Telegram chat ids. STRONGLY recommended, otherwise anyone can use your API credits.
TALIXIO_TELEGRAM_ALLOWED_IDS=
# Proactive daily messages (UTC): HH:MM|chat_id|prompt, separated by ;;
# TALIXIO_DAILY_JOBS=07:30|123456|Give me a short morning briefing
