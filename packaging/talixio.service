[Unit]
Description=Talixio AI assistant
After=network-online.target
Wants=network-online.target

[Service]
User=talixio
Group=talixio
EnvironmentFile=/etc/talixio/talixio.env
ExecStart=/usr/share/talixio/bin/talixio serve
Restart=always
RestartSec=5
StateDirectory=talixio
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/talixio

[Install]
WantedBy=multi-user.target
